# EditorConfig — keep line endings + indentation consistent across OSes
# https://editorconfig.org

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{py,rs,c,h,ino,java}]
indent_style = space
indent_size = 4

[*.{js,ts,html,json,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
